{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "root": false,
  "files": {
    "includes": ["**", "!**/node_modules", "!**/dist", "!**/.output", "!**/.wxt"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  }
}
