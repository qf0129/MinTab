{
  "name": "mintab-extension",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/qf0129/MinTab",
  "description": "A new tab page that renders your native browser bookmarks, with optional self-hosted sync.",
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "tsc --noEmit",
    "lint": "biome check --config-path=biome.json .",
    "format": "biome format --config-path=biome.json --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "lucide-react": "^0.536.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-sortablejs": "^6.1.4",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react": "^4.7.0",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "wxt": "^0.20.7"
  }
}
